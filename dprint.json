{
  "includes": [
    "**/*.toml",
    "**/*.json",
    "**/*.md",
    "**/*.yml",
    "**/*.yaml",
    "**/*.jsonc"
  ],
  "toml": {
    "lineWidth": 120
  },
  "json": {},
  "markdown": {
    "lineWidth": 120
  },
  "excludes": [
    "**/*-lock.json",
    "**/*.lock",
    "**/pixi.lock",
    "perplexity/",
    "htmlcov/",
    ".ruff_cache/"
  ],
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.22.1.wasm",
    "https://plugins.dprint.dev/toml-0.7.0.wasm",
    "https://plugins.dprint.dev/json-0.22.0.wasm"
  ]
}
