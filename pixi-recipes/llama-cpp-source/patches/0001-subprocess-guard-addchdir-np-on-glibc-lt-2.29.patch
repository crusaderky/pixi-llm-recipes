diff --git a/vendor/sheredom/subprocess.h b/vendor/sheredom/subprocess.h
index 5e809023a..fd69b7ea3 100644
--- a/vendor/sheredom/subprocess.h
+++ b/vendor/sheredom/subprocess.h
@@ -272,6 +272,16 @@ subprocess_weak int subprocess_alive(struct subprocess_s *const process);
 #include <sys/types.h>
 #include <sys/wait.h>
 #include <unistd.h>
+// posix_spawn_file_actions_addchdir_np() was added in glibc 2.29. Older glibc
+// has neither the declaration in <spawn.h> nor the symbol in libc, so there is
+// no way to honour a child working directory there -- not even via a local
+// prototype. Detect it here and report ENOSYS at the call site instead of
+// failing to compile.
+#if defined(__GLIBC__)
+#if !__GLIBC_PREREQ(2, 29)
+#define SUBPROCESS_NO_SPAWN_ADDCHDIR 1
+#endif
+#endif
 #endif
 
 #if defined(_WIN32)
@@ -1207,6 +1217,8 @@ cleanup:
   if (process_cwd) {
 #if defined(__APPLE__) && MAC_OS_X_VERSION_MIN_REQUIRED >= 260000
     posix_error = posix_spawn_file_actions_addchdir(&actions, process_cwd);
+#elif defined(SUBPROCESS_NO_SPAWN_ADDCHDIR)
+    posix_error = ENOSYS;
 #else
 #if defined(__APPLE__) && defined(__clang__)
 #pragma clang diagnostic push
