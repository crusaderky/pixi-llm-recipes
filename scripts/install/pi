#!/bin/bash
# `pi` wrapper — run `cd <workspace> && pi <extra args>` from anywhere.
#
# Installed to ~/.local/bin as a symlink to this script by `pixi r install`
# so it always runs the source tree of this repo.
#
# Special parameters:
#   --no-git           Block all GitHub access (credentials are not bound, git
#                      network transport and gh are disabled).
#   --bind <dir>       Bind an extra directory read-write. Relative paths are
#                      made absolute against your cwd BEFORE forwarding, because
#                      the sandbox task runs with the repo as its cwd.
#   --subagents        Load pi-subagents for this run (disabled by default to
#                      keep its ~3.5k system-prompt tokens out of every session).
#   --no-sandbox       Skip the bubblewrap sandbox; route to the `pi-unsafe` task
#                      (full host access, for development/debugging — no
#                      GitHub policy applies there, including --no-git).
# All other args are forwarded verbatim to pi.
#
# Git/GitHub access is on by default under a non-destructive policy (no
# force-push, no remote branch/ref deletion, no deleting/modifying GitHub
# posts), https-only: the sandbox never sees ssh keys or agent sockets.
set -o errexit
set -o nounset

REPO="$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)"
TASK=pi
TASK_UNSAFE=pi-unsafe

# --no-sandbox routes to pi-unsafe
# --bind paths made absolute (sandbox runs with the repo as its cwd).
# Consumed args are stripped, rest forwarded verbatim.
ARGS=()
i=1
while [ "$i" -le $# ]; do
  arg="${!i}"
  if [ "$arg" = "--no-sandbox" ]; then
    TASK=$TASK_UNSAFE
    i=$((i + 1))
  elif [ "$arg" = "--bind" ]; then
    next=$((i + 1))
    bd="${!next}"
    case "$bd" in /*) ;; *) bd="$PWD/$bd" ;; esac
    ARGS+=("--bind" "$bd")
    i=$((i + 2))
  else
    ARGS+=("$arg")
    i=$((i + 1))
  fi
done

WORKDIR="$PWD"
cd "$REPO"
if [ ${#ARGS[@]} -gt 0 ]; then
  export _FWD_ARGS=$(printf '%s\0' "${ARGS[@]}" | base64 -w0)
fi
exec pixi r -q "$TASK" "$WORKDIR"
